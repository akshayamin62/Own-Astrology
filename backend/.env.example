# Geocoding provider: "nominatim" (free, no key needed) or "google"
GEOCODING_PROVIDER=nominatim

# Optional: Google Maps API key for higher-accuracy geocoding
GOOGLE_MAPS_API_KEY=

# MongoDB (auth + history)
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gmail / Google Workspace SMTP (App Password, not account password)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Production: Vercel frontend URL(s), comma-separated for CORS
# Example: https://your-app.vercel.app,https://www.your-domain.com
CORS_ORIGINS=
# Or set a single frontend URL:
# FRONTEND_URL=https://your-app.vercel.app
